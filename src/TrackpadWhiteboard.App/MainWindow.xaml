<Window x:Class="TrackpadWhiteboard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trackpad Whiteboard" Height="700" Width="1200" WindowState="Maximized"
        Background="White">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#F2F2F2" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="12,8">
            <TextBlock x:Name="StatusText" FontSize="14" TextWrapping="Wrap" />
        </Border>
        <Grid>
            <InkCanvas x:Name="Board" Background="White" EditingMode="None" />
            <Canvas IsHitTestVisible="False">
                <Rectangle x:Name="WritingWindowFrame" Stroke="#802E7DD7" StrokeThickness="1"
                           StrokeDashArray="4 3" Visibility="Collapsed" />
                <Line x:Name="Caret" Stroke="#2E7DD7" StrokeThickness="2" Visibility="Collapsed" />
            </Canvas>
        </Grid>
    </DockPanel>
</Window>
